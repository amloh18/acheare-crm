[TEMPLATE]
# =============================================================================
# ACHARE DEPLOYMENT CONFIGURATION
# =============================================================================
#
# Copy to `.env` next to this file and fill in the secrets:
#
#     cp deploy/.env.example deploy/.env
#     deploy/scripts/achare init      # or fill it in by hand
#
# Every variable below is read by the application. Names that look plausible but
# do not exist in the code (for example STORAGE_DRIVER or STORAGE_PATH) are
# silently ignored, and the app falls back to a default — which is how a
# deployment ends up writing files to local disk while the operator believes it
# is using S3. If you add a variable, add it to the code first.
#
# `achare doctor` validates this file.

# ------------------------------------------------------------------------------
# 1. IMAGE / RELEASE
# ------------------------------------------------------------------------------
# ACHARE_VERSION is set by the CLI from the repo VERSION file. Override it only
# to pin a specific release or to roll back.
# ACHARE_VERSION=0.1.0

# Production pulls immutable tags from GHCR. For a local build, set:
#   ACHARE_IMAGE=achare/server
# and build with:
#   docker build -f deploy/docker/server.Dockerfile --build-arg ACHARE_VERSION=0.1.0 -t achare/server:0.1.0 twenty-upstream/
ACHARE_IMAGE=ghcr.io/amloh18/achare-server

# Deployment profile: local | production | desktop
ACHARE_PROFILE=local

# ------------------------------------------------------------------------------
# 2. APPLICATION
# ------------------------------------------------------------------------------
NODE_ENV=production
NODE_PORT=3000

# The public origin of this installation. Cookies, invitation links and email
# links are generated from it, so it must match what the browser sees.
SERVER_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 3. DATABASE
# ------------------------------------------------------------------------------
# The connection URL is derived by docker-compose from the parts below, so the
# Postgres container and the server can never disagree about the password.
PG_DATABASE_USER=achare
PG_DATABASE_PASSWORD=
PG_DATABASE_NAME=default
# Host port published by the local profile:
PG_DATABASE_PORT=5432

# ------------------------------------------------------------------------------
# 4. REDIS
# ------------------------------------------------------------------------------
REDIS_URL=redis://redis:6379
# Host port published by the local profile:
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# 5. SECURITY
# ------------------------------------------------------------------------------
# ENCRYPTION_KEY encrypts sensitive fields (salary, bank details). Losing it
# makes that data unreadable, so it must be preserved outside the database and
# included in backups. Rotate only with FALLBACK_ENCRYPTION_KEY set.
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=
# FALLBACK_ENCRYPTION_KEY=

# Signs JWTs and password-reset links. Rotating it logs everyone out.
# Generate with: openssl rand -base64 32
APP_SECRET=

# ------------------------------------------------------------------------------
# 6. STORAGE
# ------------------------------------------------------------------------------
# Valid values are LOCAL and S_3. "local" and "s3" are normalised to those.
STORAGE_TYPE=LOCAL
# Container path of the storage volume for the LOCAL driver:
STORAGE_LOCAL_PATH=/app/packages/twenty-server/.local-storage
# Host directory bind-mounted to the path above by the local profile:
ACHARE_STORAGE_PATH=./.data/storage

# Required when STORAGE_TYPE=S_3 (AWS S3, Cloudflare R2, MinIO, Wasabi…)
# STORAGE_S3_REGION=eu-west-3
# STORAGE_S3_NAME=achare-documents
# STORAGE_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=
# Only needed when STORAGE_S3_ENDPOINT is not reachable by browsers:
# STORAGE_S3_PRESIGNED_URL_BASE=https://storage.example.com

# ------------------------------------------------------------------------------
# 7. EMAIL
# ------------------------------------------------------------------------------
# Without these, invitations and notifications are logged instead of sent.
EMAIL_FROM_ADDRESS=noreply@yourdomain.com
EMAIL_FROM_NAME=ACHEARE

# ------------------------------------------------------------------------------
# 8. PUBLIC INGRESS (production profile only)
# ------------------------------------------------------------------------------
# Domain Caddy obtains a certificate for, and the ACME account email.
ACHARE_DOMAIN=
ACHARE_ACME_EMAIL=

# ------------------------------------------------------------------------------
# 9. BACKUP (used by deploy/backup/backup.sh)
# ------------------------------------------------------------------------------
# Backup retention: how many days of daily backups to keep.
# Set to 0 to disable automatic pruning.
ACHARE_BACKUP_RETENTION_DAYS=30
# Backup compression: zstd (preferred) or gzip.
# zstd produces smaller archives but requires the zstd binary.
ACHARE_BACKUP_COMPRESSION=zstd
